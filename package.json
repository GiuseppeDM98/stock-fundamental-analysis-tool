{
  "name": "stock-fundamental-analysis-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "e2e": "playwright test --project=e2e",
    "e2e:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "e2e:visual:update": "playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@vitest/coverage-v8": "^4.1.11",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.18.2",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.30",
    "node-html-parser": "^7.1.0",
    "prisma": "^7.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "yahoo-finance2": "^3.13.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.5",
    "postcss-selector-parser": "^7.1.6"
  }
}
