// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  passwordHash            String
  createdAt               DateTime            @default(now())
  analyses                Analysis[]
  positions               Position[]
  snapshots               PortfolioSnapshot[]
  watchlistItems          WatchlistItem[]
  watchlistRuns           WatchlistRun[]
  advisorSessions         AdvisorSession[]
  earningsEstimates       EarningsEstimate[]
  // null = use account email
  watchlistEmail          String?
  // "biweekly" | "monthly"
  watchlistFreq           String              @default("biweekly")
  // When false the cron skips this user entirely — useful when not actively investing
  watchlistEnabled        Boolean             @default(true)
  // Rate-limit manual trigger to once per 24h
  lastManualWatchlistRun  DateTime?
  // Global AI preferences — per-model/effort/thinking default used by every AI call
  // site (deep-value, verify, advisor, earnings) unless overridden per-request.
  // "claude-opus-4-8" | "claude-sonnet-5" | "deepseek-v4-pro"
  aiModel                 String              @default("claude-opus-4-8")
  // "low" | "medium" | "high" | "xhigh" | "max"
  aiEffort                String              @default("high")
  aiThinkingEnabled        Boolean             @default(true)
}

model Analysis {
  id               String   @id @default(cuid())
  userId           String
  ticker           String
  companyName      String
  reportMd         String
  mosPercent       Float
  // Price snapshot at save time — used to track performance vs current price
  priceAtAnalysis  Float?
  fairValueBull    Float?
  fairValueBase    Float?
  fairValueBear    Float?
  valuationMethod  String?
  // Optional "Analyst Review" — an independent red-team critique of this report.
  // Null until the user runs the review (either before saving or later from the
  // saved-analysis detail page). Stored as plain Markdown (no JSON block).
  reviewMd         String?
  // The reviewer's own independent valuation, parsed from the review's leading JSON
  // block. Same unit as fairValue* above (MoS-adjusted buy targets), so the two can be
  // averaged into a consensus. Null when no review was run or it emitted no valid JSON.
  // NOTE: review* is the "skeptic" analyst of the analyst panel (kept under the legacy
  // name to avoid renaming a shipped column). The optimist/quality analysts below mirror
  // this exact shape; the consensus is the mean of the base analysis + every analyst run.
  reviewFairValueBull   Float?
  reviewFairValueBase   Float?
  reviewFairValueBear   Float?
  reviewValuationMethod String?
  // Optimist ("Rialzista") analyst — constructive bull-case second opinion. Same
  // MoS-adjusted buy-target unit as fairValue*/reviewFairValue*. Null until run.
  optimistFairValueBull   Float?
  optimistFairValueBase   Float?
  optimistFairValueBear   Float?
  optimistValuationMethod String?
  optimistCritiqueMd      String?
  // Quality/durability ("Qualità") analyst — long-term owner's view (moat, ROIC, balance
  // sheet resilience). Same unit as above. Null until run.
  qualityFairValueBull   Float?
  qualityFairValueBase   Float?
  qualityFairValueBear   Float?
  qualityValuationMethod String?
  qualityCritiqueMd      String?
  // Blind-first commitment (docs/deep-value-rigor-v2-spec.md §6) — the lens's OWN
  // bull/base/bear JSON (DeepValueResult, incl. killPrice/revisions for skeptic),
  // committed BEFORE it ever saw the report. Null until a blind-first (Grounded) lens run
  // completes Phase 1 successfully; never set for a Quick-mode or degraded-Phase-1 run.
  // Persisted ALONGSIDE the existing *FairValue* columns (which hold the FINAL,
  // post-reconciliation triple and remain what feeds the consensus/ruler/watchlist/digest —
  // spec §6.4: "zero churn a valle"), one flat column per lens (not a shared blob — the
  // panel can run all three lenses in parallel, and a shared blob would race on
  // read-modify-write).
  reviewBlindJson    String?
  optimistBlindJson  String?
  qualityBlindJson   String?
  // Grounded Deep Value mode (docs/deep-value-grounding-spec.md): the confirmed
  // GroundingPayload (raw paste blocks + the structured extract) as JSON, when the
  // analysis was generated with pasted financial data. Null for Quick-mode analyses.
  // NOT selected by the GET /api/analyses list (it's a blob the list never uses — see
  // the select in app/api/analyses/route.ts) and NOT part of SavedAnalysis (see
  // types/analysis.ts) — both exclusions are deliberate, not oversights.
  groundingJson    String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Daily portfolio value snapshot written by the Vercel cron job.
// costEur stored separately so the chart can draw the cost-basis line without parsing data JSON.
// data stores FX rates used at snapshot time — never recalculated retroactively.
model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  takenAt  DateTime @default(now())
  totalEur Float
  costEur  Float
  data     String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

// Ticker the user wants to monitor periodically via the AI cron digest.
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  ticker      String
  companyName String
  mosPercent  Float    @default(0.20)
  notes       String?
  addedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

// Result of each cron/manual analysis run per ticker per user.
// Retained for last-run display in the UI and future trend tracking.
model WatchlistRun {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  runAt         DateTime @default(now())
  fairValueBull Float?
  fairValueBase Float?
  fairValueBear Float?
  method        String?
  sector        String?
  currency      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runAt])
  @@index([userId, ticker])
}

// Tracks real purchases made by the user for long-term P&L tracking.
model Position {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  // Optional ISIN for dividend tracking via Borsa Italiana (elenco-completo-dividendi).
  // Only useful for stocks listed on Borsa Italiana (MTAA). Leave blank for US/other exchanges.
  isin          String?
  companyName   String
  purchasePrice Float
  shares        Float
  currency      String   @default("EUR")
  purchasedAt   DateTime
  notes         String?
  // User's applicable capital gains tax rate for this position (e.g. 26.0 for Italy).
  // Used client-side to show estimated tax on unrealized gains and net dividend amounts.
  capitalGainsTaxRate Float?
  // Position close (sale) tracking. Both null = still open. When the user sells a lot,
  // closedAt + sellPrice are set (sellPrice in the position's own currency). A partial sale
  // splits the lot: the open row keeps the remaining shares, a new closed row holds the sold shares.
  // Closed positions are archived (kept for realized-P&L history), never valued as current holdings.
  closedAt      DateTime?
  sellPrice     Float?
  // Set true once a daily snapshot has recorded this sale's realized P&L (the chart's "Sold"
  // marker), so it is counted exactly once — regardless of a back-dated sellDate. Open lots
  // stay false and are never recorded until closed.
  realizedRecorded Boolean @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, ticker])
}

// AI-fetched next-earnings date per ticker, populated on demand by the user (a button
// that runs Claude Sonnet 5 with web search). Persisted so the calendar survives reloads
// without re-running the model. One row per user per ticker (upserted on refresh).
model EarningsEstimate {
  id               String    @id @default(cuid())
  userId           String
  ticker           String
  // Next quarterly report date the AI found; null when it couldn't verify a future one.
  nextEarningsDate DateTime?
  // AI-declared confidence: "confirmed" | "estimated" | "unknown".
  confidence       String    @default("unknown")
  // Optional citation the AI used, kept for transparency/debugging.
  sourceUrl        String?
  // When the AI last ran for this ticker — the UI shows "updated <date>".
  fetchedAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

// AI Portfolio Advisor chat sessions.
// Each session has a title derived from the first user message.
model AdvisorSession {
  id        String           @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  AdvisorMessage[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Individual messages within an advisor chat session.
model AdvisorMessage {
  id        String         @id @default(cuid())
  sessionId String
  // "user" | "assistant"
  role      String
  content   String
  createdAt DateTime       @default(now())
  session   AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
