// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  analyses     Analysis[]
  positions    Position[]
  snapshots    PortfolioSnapshot[]
}

model Analysis {
  id               String   @id @default(cuid())
  userId           String
  ticker           String
  companyName      String
  reportMd         String
  mosPercent       Float
  // Price snapshot at save time — used to track performance vs current price
  priceAtAnalysis  Float?
  fairValueBull    Float?
  fairValueBase    Float?
  fairValueBear    Float?
  valuationMethod  String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Daily portfolio value snapshot written by the Vercel cron job.
// costEur stored separately so the chart can draw the cost-basis line without parsing data JSON.
// data stores FX rates used at snapshot time — never recalculated retroactively.
model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  takenAt  DateTime @default(now())
  totalEur Float
  costEur  Float
  data     String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

// Tracks real purchases made by the user for long-term P&L tracking.
model Position {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  companyName   String
  purchasePrice Float
  shares        Float
  currency      String   @default("EUR")
  purchasedAt   DateTime
  notes         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, ticker])
}
