// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  passwordHash            String
  createdAt               DateTime            @default(now())
  analyses                Analysis[]
  positions               Position[]
  snapshots               PortfolioSnapshot[]
  watchlistItems          WatchlistItem[]
  watchlistRuns           WatchlistRun[]
  advisorSessions         AdvisorSession[]
  // null = use account email
  watchlistEmail          String?
  // "biweekly" | "monthly"
  watchlistFreq           String              @default("biweekly")
  // When false the cron skips this user entirely — useful when not actively investing
  watchlistEnabled        Boolean             @default(true)
  // Rate-limit manual trigger to once per 24h
  lastManualWatchlistRun  DateTime?
}

model Analysis {
  id               String   @id @default(cuid())
  userId           String
  ticker           String
  companyName      String
  reportMd         String
  mosPercent       Float
  // Price snapshot at save time — used to track performance vs current price
  priceAtAnalysis  Float?
  fairValueBull    Float?
  fairValueBase    Float?
  fairValueBear    Float?
  valuationMethod  String?
  // Optional "Analyst Review" — an independent red-team critique of this report.
  // Null until the user runs the review (either before saving or later from the
  // saved-analysis detail page). Stored as plain Markdown (no JSON block).
  reviewMd         String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Daily portfolio value snapshot written by the Vercel cron job.
// costEur stored separately so the chart can draw the cost-basis line without parsing data JSON.
// data stores FX rates used at snapshot time — never recalculated retroactively.
model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  takenAt  DateTime @default(now())
  totalEur Float
  costEur  Float
  data     String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

// Ticker the user wants to monitor periodically via the AI cron digest.
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  ticker      String
  companyName String
  mosPercent  Float    @default(0.20)
  notes       String?
  addedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

// Result of each cron/manual analysis run per ticker per user.
// Retained for last-run display in the UI and future trend tracking.
model WatchlistRun {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  runAt         DateTime @default(now())
  fairValueBull Float?
  fairValueBase Float?
  fairValueBear Float?
  method        String?
  sector        String?
  currency      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runAt])
  @@index([userId, ticker])
}

// Tracks real purchases made by the user for long-term P&L tracking.
model Position {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  // Optional ISIN for dividend tracking via Borsa Italiana (elenco-completo-dividendi).
  // Only useful for stocks listed on Borsa Italiana (MTAA). Leave blank for US/other exchanges.
  isin          String?
  companyName   String
  purchasePrice Float
  shares        Float
  currency      String   @default("EUR")
  purchasedAt   DateTime
  notes         String?
  // User's applicable capital gains tax rate for this position (e.g. 26.0 for Italy).
  // Used client-side to show estimated tax on unrealized gains and net dividend amounts.
  capitalGainsTaxRate Float?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, ticker])
}

// AI Portfolio Advisor chat sessions.
// Each session has a title derived from the first user message.
model AdvisorSession {
  id        String           @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  AdvisorMessage[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Individual messages within an advisor chat session.
model AdvisorMessage {
  id        String         @id @default(cuid())
  sessionId String
  // "user" | "assistant"
  role      String
  content   String
  createdAt DateTime       @default(now())
  session   AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
